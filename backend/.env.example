# EcoSort AI configuration
# 1. Copy this file to ".env" (never commit ".env" to GitHub).
# 2. Fill in the values for the AI service you actually have access to.
# If AI_API_URL or AI_MODEL is empty, the app runs in clearly labelled Demo Mode.

# Any OpenAI-compatible chat-completions endpoint.
# Example (local Ollama, no key needed):
#   AI_API_URL=http://localhost:11434/v1/chat/completions
#   AI_MODEL=granite3.3:2b        # check the exact tag with `ollama list`
AI_API_URL=
AI_MODEL=
AI_API_KEY=your_api_key_here

# Optional
AI_TIMEOUT_SECONDS=20
RATE_LIMIT_PER_MINUTE=30
# ALLOWED_ORIGINS=http://localhost:5000,http://127.0.0.1:5000
# PORT=5000
